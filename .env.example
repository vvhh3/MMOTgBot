BOT_TOKEN=123456:replace-me
SESSION_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_URL=http://localhost:5173
# Дополнительные origin-ы для CORS (через запятую). Полезно при локальной разработке: http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/mmobot.db
VITE_API_BASE_URL=http://localhost:4000
# DEV: включите для отладки без Telegram (поддельный initData на клиенте и пропуск проверки подписи на сервере)
DEV_BYPASS_AUTH=true
VITE_DEV_MODE=true
